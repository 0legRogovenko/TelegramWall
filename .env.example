# Required: Telegram Bot API
TELEGRAM_BOT_TOKEN=1234567890:replace-with-bot-token
TELEGRAM_WEBHOOK_URL=
# TELEGRAM_WEBHOOK_SECRET=replace-only-for-webhook-mode
TELEGRAM_ADMIN_IDS=123456789

# Required: Telethon reader account
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=replace-with-api-hash
TELEGRAM_PHONE=+79000000000
# Used only by the local file-session fallback.
TELEGRAM_SESSION_NAME=userbot
# Run auth_userbot.py once to generate this for CI/production.
TELEGRAM_SESSION_STRING=replace-with-string-session

# Required: persistent PostgreSQL (Supabase Session Pooler example)
DATABASE_URL=postgresql://postgres.PROJECT_REF:replace-with-password@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Optional: Anthropic AI. Leave the key empty to disable summaries and filters.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_FILTER_MODEL=claude-haiku-4-5
AI_DAILY_SUMMARY_LIMIT=20

# Optional: Telegram payments. Empty YooKassa token selects Telegram Stars.
YOOKASSA_PROVIDER_TOKEN=
SUBSCRIPTION_PRICE_BASIC_STARS=149
SUBSCRIPTION_PRICE_PRO_STARS=499
SUBSCRIPTION_PRICE_ANNUAL_BASIC_STARS=1430
SUBSCRIPTION_PRICE_ANNUAL_PRO_STARS=4790
# RUB values are kopecks.
SUBSCRIPTION_PRICE_BASIC_RUB=19900
SUBSCRIPTION_PRICE_PRO_RUB=49900
SUBSCRIPTION_PRICE_ANNUAL_BASIC_RUB=199000
SUBSCRIPTION_PRICE_ANNUAL_PRO_RUB=479000

# Product limits and schedules
CHANNEL_LIMIT_FREE=3
CHANNEL_LIMIT_BASIC=10
TRIAL_DAYS=3
SUBSCRIPTION_WARNING_HOURS=24
UPSELL_INTERVAL_DAYS=3
UPSELL_BATCH_SIZE=50
REFERRAL_BONUS_DAYS=3
DIGEST_HOUR_UTC=8
POST_RETENTION_DAYS=3
MEDIA_MAX_MB=20
# Comma-separated usernames without @; admins can extend this with /block.
BLOCKED_CHANNELS=
ADMIN_REPORT_HOUR_UTC=7

# Local Flask health/webhook server
FLASK_SECRET_KEY=replace-with-random-secret
FLASK_PORT=5001
FLASK_DEBUG=false

# GitHub repository Variables for the external watchdog, not bot process env:
# HEARTBEAT_STALE_MINUTES=20
# REALERT_HOURS=6
